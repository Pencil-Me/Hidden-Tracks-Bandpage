    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@kolirt/vue-modal": "^1.1.2",
    "@vueuse/head": "^2.0.0",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.9.0",
    "bootstrap": "^5.3.6",
    "bootstrap-vue-next": "^0.29.2",
    "lozad": "^1.16.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@rushstack/eslint-patch": "^1.11.0",
